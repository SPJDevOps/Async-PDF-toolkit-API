# Application
APP_NAME=Async PDF Toolkit API
APP_ENV=development
APP_DEBUG=false

# Optional. When set, job endpoints require header: X-API-Key
# Leave empty/unset for local/dev and open public demos.
API_KEY=

# Limits (tighten these for a public demo — see README)
MAX_UPLOAD_BYTES=20000000
MAX_PDF_PAGES=100
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=30
JOB_TIMEOUT_SECONDS=300
